{
	"name": "goden-frontend",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"packageManager": "pnpm@10.28.1",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"build:keycloak-theme": "tsc -b && vite build && keycloakify build",
		"preview": "vite preview",
		"api:types": "openapi-typescript ../backend/api/openapi.yaml -o src/shared/api/schema.gen.ts",
		"icons:nav": "node scripts/gen-nav-icons.mjs && prettier --write src/shared/ui/icon/nav-icons.gen.tsx",
		"typecheck": "tsc -b",
		"lint": "eslint .",
		"lint:styles": "stylelint \"src/**/*.css\" --allow-empty-input",
		"lint:fsd": "steiger ./src",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:watch": "vitest",
		"check": "pnpm typecheck && pnpm lint && pnpm lint:styles && pnpm lint:fsd && pnpm format:check && pnpm test"
	},
	"dependencies": {
		"@base-ui/react": "^1.9.0",
		"@emotion/react": "^11.14.0",
		"@emotion/styled": "^11.14.1",
		"@fontsource-variable/golos-text": "^5.3.0",
		"@material-symbols/svg-400": "^0.48.0",
		"@mui/material": "^9.5.0",
		"@mui/x-charts": "^9.15.0",
		"@mui/x-date-pickers": "^9.15.0",
		"@tanstack/react-form": "^1.33.5",
		"@tanstack/react-query": "^5.104.1",
		"@tanstack/react-router": "^1.170.42",
		"axios": "^1.20.0",
		"date-fns": "^4.4.0",
		"eventsource": "^5.1.3",
		"keycloak-js": "^26.2.4",
		"keycloakify": "^11.16.1",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"zod": "^4.6.5",
		"zustand": "^5.0.15"
	},
	"devDependencies": {
		"@babel/core": "^7.29.7",
		"@eslint/js": "^10.0.1",
		"@feature-sliced/steiger-plugin": "^0.8.0",
		"@rolldown/plugin-babel": "^0.2.4",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@tanstack/eslint-plugin-query": "^5.104.1",
		"@tanstack/eslint-plugin-router": "^1.162.0",
		"@tanstack/react-query-devtools": "^5.104.1",
		"@tanstack/react-router-devtools": "^1.167.2",
		"@tanstack/router-plugin": "^1.168.43",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.7",
		"@types/babel__core": "^7.20.5",
		"@types/node": "^24.19.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"babel-plugin-react-compiler": "^1.0.0",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.7",
		"globals": "^17.13.0",
		"jsdom": "^30.1.2",
		"openapi-typescript": "^7.13.0",
		"prettier": "^3.9.10",
		"steiger": "^0.7.0",
		"stylelint": "^17.16.0",
		"stylelint-config-standard": "^40.0.0",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.71.1",
		"vite": "^8.3.4",
		"vite-plugin-svgr": "^5.2.0",
		"vitest": "^5.0.3"
	}
}
