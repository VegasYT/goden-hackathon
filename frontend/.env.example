# Keycloak для входа; без значений используется локальный стенд
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=goden
VITE_KEYCLOAK_CLIENT_ID=goden-web

# Раздел «Генератор» у владельца; false скрывает его
VITE_GENERATOR_ENABLED=true

# Куда pnpm dev проксирует запросы /api
API_PROXY_TARGET=http://localhost:8080
