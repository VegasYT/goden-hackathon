# Настройки сервера для infra/compose.prod.yaml.
# Скопируй в infra/.env на сервере и заполни. Файл .env в репозиторий не попадает.
# Значения без пробелов и без символов @ : / ? # % (пароль PostgreSQL подставляется в адрес подключения).
# Сгенерировать значение: openssl rand -hex 24

# Домен приложения. Keycloak будет на auth.<домен>, Grafana на grafana.<домен>.
DOMAIN=goden.pro
# https - сертификаты Let's Encrypt; http - только для локальной проверки
SCHEME=https
# Домен сервиса доставки Мигом на этом же сервере (migom.site по умолчанию): см. infra/README.md
# MIGOM_DOMAIN=migom.site

POSTGRES_PASSWORD=

# Минимальный уровень логов API, worker и generator: debug, info, warn или error.
LOG_LEVEL=info

# консоль администратора Keycloak: https://auth.<домен>
KEYCLOAK_ADMIN_PASSWORD=
# секрет сервисной учётной записи генератора
GENERATOR_CLIENT_SECRET=
# секреты клиентов сервиса доставки Мигом: migom-backend (вход пользователей Мигома) и
# migom-integration (меню и заказы в API Goden). Пустой - клиенту выставляется случайный секрет
MIGOM_BACKEND_SECRET=
MIGOM_INTEGRATION_SECRET=

# Пароли тестовых пользователей (логин: admin, manager, approver, cook, waiter). admin - владелец
# демонстрационной компании "Демо", остальные назначены на её первую точку в своих ролях.
# Применяются только при первом создании тома Keycloak: позже пароль меняют в консоли администратора.
GODEN_PASSWORD_ADMIN=
GODEN_PASSWORD_MANAGER=
GODEN_PASSWORD_APPROVER=
GODEN_PASSWORD_COOK=
GODEN_PASSWORD_WAITER=

# Подтверждение почты при регистрации. false - регистрация без письма (для проверок),
# true - новый пользователь входит только после перехода по ссылке из письма.
# Применить после смены: docker compose -f infra/compose.prod.yaml up -d --force-recreate keycloak-config
KEYCLOAK_VERIFY_EMAIL=false
# Почтовый сервер для писем Keycloak; без него подтверждение почты не включается.
# Порт 465 - TLS, 587 - STARTTLS. Пароль - пароль приложения почтового ящика, не основной.
# В этих значениях символ @ допустим.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# адрес отправителя; пусто - совпадает с SMTP_USER
SMTP_FROM=

# Grafana: https://grafana.<домен>, пользователь admin
GRAFANA_ADMIN_PASSWORD=

# Необязательно: адрес frontend, запущенного у разработчика (pnpm dev), например http://localhost:5173.
# Если задан, вход через Keycloak сервера и запросы к API разрешены и с него.
# Перед показом оставь пустым, если не нужен.
DEV_WEB_URL=

# Необязательно: false скрывает у владельца раздел «Генератор» во frontend (запуск генератора
# и тестовые поставки). Без значения раздел есть. Меняется пересборкой frontend: sh infra/deploy.sh.
GENERATOR_UI=

# Уведомления в Telegram. Необязательно: оставь обе пустыми, чтобы работать без уведомлений.
# Задавать нужно обе сразу, иначе worker не запустится. Токен выдаёт @BotFather.
# TELEGRAM_CHAT_ID - общий чат: в него приходят только сообщения об ошибках обработчиков.
# Уведомления о сроках и списании просрочки приходят в чат точки, который задаёт её владелец.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Чат первой точки демонстрационной компании (числовой идентификатор). Необязательно:
# без него демонстрационная точка уведомлений не получает. Можно указать тот же чат,
# что и в TELEGRAM_CHAT_ID. Меняется позже в приложении владельцем точки.
DEMO_TELEGRAM_CHAT_ID=
# Прокси для Telegram, нужен на серверах в РФ: socks5://пользователь:пароль@хост:порт
# Без рабочего прокси worker запускается, но уведомления не доходят: причина видна в его журнале.
TELEGRAM_PROXY_URL=
