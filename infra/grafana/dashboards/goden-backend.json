      "id": 20,
      "type": "stat",
      "title": "Ошибки по сервисам за период",
      "description": "Количество структурированных записей уровня ERROR за выбранный период",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 61,
        "w": 24,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum by (compose_service) (count_over_time({environment=~\"${environment:regex}\", compose_service=~\"${service:regex}\"} | json | __error__=\"\" | level=\"ERROR\" [$__range]))",
          "legendFormat": "{{compose_service}}",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
