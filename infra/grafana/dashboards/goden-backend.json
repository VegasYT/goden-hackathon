          "expr": "{environment=~\"${environment:regex}\", compose_service=~\"${service:regex}\"} | json | __error__=\"\" | level=~\"${level:regex}\" | correlation_id=~`${correlation_id:raw}`",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
